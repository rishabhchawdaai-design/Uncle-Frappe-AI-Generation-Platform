# Uncle Frappe AI Generation Platform — Environment Template
# Copy to .env and fill in the keys you hold. All values are optional;
# free/open providers work without keys.

# Provider API keys
STABILITY_API_KEY=
REPLICATE_API_TOKEN=

# External search / MCP server keys (see configs/mcp_servers.json)

# Kimi K3 (Moonshot AI) — official cloud API + self-hosted execution paths
# Cloud API: https://platform.kimi.ai -> API keys -> MOONSHOT_API_KEY
MOONSHOT_API_KEY=
KIMI_K3_API_BASE=https://api.moonshot.ai/v1
# Self-hosted vLLM server (vllm/vllm-openai:kimi-k3) — set to enable
KIMI_K3_VLLM_URL=
KIMI_K3_VLLM_API_KEY=
# Self-hosted SGLang server (lmsysorg/sglang:kimi-k3) — set to enable
KIMI_K3_SGLANG_URL=
KIMI_K3_SGLANG_API_KEY=
FIRECRAWL_API_KEY=
BRIGHT_DATA_API_KEY=
JINA_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
SERPAPI_KEY=
APIFY_TOKEN=
CRAWL4AI_API_KEY=
OPENAI_API_KEY=

# Infrastructure
SEARXNG_BASE_URL=http://localhost:8080
SELENIUM_GRID_URL=http://localhost:4444/wd/hub
