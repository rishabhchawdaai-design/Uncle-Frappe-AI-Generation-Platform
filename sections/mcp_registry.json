{
  "mcp_servers": {
    "exa": {
      "command": "npx",
      "args": [
        "-y",
        "@anthropic-ai/mcp-server-exa"
      ],
      "tools": [
        "search",
        "get_contents"
      ]
    },
    "tavily": {
      "command": "npx",
      "args": [
        "-y",
        "tavily-mcp"
      ],
      "tools": [
        "tavily-search",
        "tavily-extract"
      ]
    },
    "brave": {
      "command": "npx",
      "args": [
        "-y",
        "@anthropic-ai/mcp-server-brave-search"
      ],
      "tools": [
        "brave_search"
      ]
    },
    "reddit": {
      "command": "npx",
      "args": [
        "-y",
        "reddit-mcp"
      ],
      "tools": [
        "search_posts",
        "get_comments"
      ]
    },
    "twitter": {
      "command": "npx",
      "args": [
        "-y",
        "twitter-mcp"
      ],
      "tools": [
        "search_tweets",
        "get_user"
      ]
    },
    "neo4j": {
      "command": "npx",
      "args": [
        "-y",
        "neo4j-mcp"
      ],
      "tools": [
        "cypher_query",
        "get_schema"
      ]
    },
    "weaviate": {
      "command": "npx",
      "args": [
        "-y",
        "weaviate-mcp"
      ],
      "tools": [
        "search",
        "insert",
        "get_schema"
      ]
    },
    "qdrant": {
      "command": "npx",
      "args": [
        "-y",
        "qdrant-mcp"
      ],
      "tools": [
        "search",
        "upsert",
        "create_collection"
      ]
    },
    "chroma": {
      "command": "npx",
      "args": [
        "-y",
        "chroma-mcp"
      ],
      "tools": [
        "query",
        "add",
        "create_collection"
      ]
    },
    "elasticsearch": {
      "command": "npx",
      "args": [
        "-y",
        "elasticsearch-mcp"
      ],
      "tools": [
        "search",
        "index",
        "mappings"
      ]
    }
  }
}